# رابط قاعدة بيانات PostgreSQL (Neon أو Supabase أو أي خادم Postgres).
# على Vercel يُضاف تلقائيًا عند ربط قاعدة Neon.
DATABASE_URL=postgres://user:password@host:5432/dbname

# بريدات حسابات الإدارة، مفصولة بفواصل. لا يدخل لوحة الإدارة إلا حساب بأحد هذه البريدات.
ADMIN_EMAILS=

# كلمة مرور الإدارة: خطوة ثانية مطلوبة بعد تسجيل الدخول بحساب مدير (8 أحرف على الأقل).
# تُضاف في إعدادات Vercel فقط، ولا تُكتب في الكود أبدًا.
ADMIN_PASSWORD=

# العنوان العام للموقع (يُستخدم في روابط استعادة كلمة المرور ورموز QR).
APP_URL=http://localhost:3000

# اختياري: مفتاح Resend لإرسال رسائل استعادة كلمة المرور بالبريد.
# بدونه يستطيع المدير إنشاء رابط استعادة للطالب من لوحة الإدارة.
RESEND_API_KEY=
MAIL_FROM=
