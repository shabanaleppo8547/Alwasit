# رابط قاعدة بيانات PostgreSQL (Neon أو Supabase أو أي خادم Postgres).
# على Vercel يُضاف تلقائيًا عند ربط قاعدة Neon.
DATABASE_URL=postgres://user:password@host:5432/dbname

# البريد الإلكتروني لحساب المدير (أو عدة بريدات مفصولة بفواصل).
# أول حساب يُسجَّل بهذا البريد يحصل على صلاحية المدير تلقائيًا.
ADMIN_EMAILS=

# العنوان العام للموقع (يُستخدم في روابط استعادة كلمة المرور ورموز QR).
APP_URL=http://localhost:3000

# اختياري: مفتاح Resend لإرسال رسائل استعادة كلمة المرور بالبريد.
# بدونه يستطيع المدير إنشاء رابط استعادة للطالب من لوحة الإدارة.
RESEND_API_KEY=
MAIL_FROM=
